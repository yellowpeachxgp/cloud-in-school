# Public deployment
NODE_ENV=production
APP_ENV=production
PORT=4100
CONSOLE_PORT=4101
FINANCE_BRIDGE_PORT=4102
MOCK_SCHOOL_PORT=4103
PUBLIC_BASE_URL=https://campus.yellowpeachxgp.com
API_BASE_URL=https://campus.yellowpeachxgp.com/api/v1
ADMIN_BASE_URL=https://campus.yellowpeachxgp.com/console
TZ=UTC
DEFAULT_SCHOOL_TIMEZONE=Asia/Shanghai

# XPEACH SSO (Read-only upstream; zero source code modification)
# NOTE: these are raw secret VALUES read directly by the process — do not paste
# secret:// references here; resolve them before starting the service.
OIDC_DISCOVERY_URL=https://sso.xpeach.codes/t/acme/.well-known/openid-configuration
OIDC_CLIENT_ID=day-in-school-cloud
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://campus.yellowpeachxgp.com/api/v1/auth/oidc/callback
OIDC_EXPECTED_ISSUER=https://sso.xpeach.codes/t/acme
OIDC_ALLOWED_SCOPES=openid profile email

# Admin access: comma-separated XPEACH sso_sub values allowed to log in.
# Only ADMIN / PLATFORM_OWNER role holders can authenticate when
# CLOUD_REQUIRE_ADMIN_ACCESS is enabled (default: on).
CLOUD_REQUIRE_ADMIN_ACCESS=true
CLOUD_ADMIN_SSO_SUBJECTS=

# Database & queue
DATABASE_URL_REF=secret://campus-cloud/prod/postgres
# 此示例用于 Docker Compose，路径必须位于挂载的数据卷内。
# systemd 裸机部署请改为 /opt/cloud-in-school/.data/cloud-state.json。
# 旧 DIS_PERSIST_PATH 仍兼容，二者同时设置时以此变量为准。
CLOUD_SNAPSHOT_PATH=/app/.data/cloud-state.json
# Optional startup-managed per-school operations grants, as one-line JSON.
# Only deployment operators may set this. Removing an entry and restarting revokes
# the bootstrap-managed grant; entries already granted manually are not revoked.
# Example: [{"cloud_user_id":"<cloud-user-uuid>","school_id":"haut","permission":"place.status.moderate","granted_by_ref":"<change-ref>"}]
CLOUD_OPERATIONS_SCHOOL_GRANTS=[]
# systemd 的 TimeoutStopSec 或容器 stop_grace_period 必须大于独立 supervisor 硬预算。
SHUTDOWN_TIMEOUT_MS=15000
SHUTDOWN_HARD_TIMEOUT_MS=20000
REDIS_URL=redis://127.0.0.1:6379/0
KMS_KEY_ID=cn-kms-campus-cloud-kek-v1
# REQUIRED in production (fail-closed when unset): raw entropy for KMS KEK and
# session/cookie signing. `secret://` values are rejected as unresolved references.
KMS_MASTER_SEED=
CLOUD_SESSION_SIGNING_KEY_REF=

# Finance & XPeach SSO settlement (required by API & finance-bridge when FINANCE_ENABLE_REAL_DEBITS=true)
SSO_FINANCE_BASE_URL=https://sso.xpeach.codes
SSO_INTERNAL_SERVICE_KEY=
FINANCE_BRIDGE_ALLOWED_SITE=dis
FINANCE_ENABLE_REAL_DEBITS=false

# Library provider: fail closed by default
SCHOOL_AUTOMATION_GLOBAL_ENABLED=false
SCHOOL_HAUT_AUTOMATION_ENABLED=false
SCHOOL_HAUT_AUTHORIZATION_EVIDENCE_REF=
SCHOOL_HAUT_MAX_CONCURRENT_WRITES=0
SCHOOL_HAUT_ALLOWED_OPERATIONS=READ_MY_BOOKINGS

# Logging and audit
LOG_REDACTION_STRICT=true
AUDIT_RETENTION_DAYS=180

# Public deployment
APP_ENV=production
PORT=4100
CONSOLE_PORT=4101
FINANCE_BRIDGE_PORT=4102
MOCK_SCHOOL_PORT=4103
PUBLIC_BASE_URL=https://campus.yellowpeachxgp.com
API_BASE_URL=https://campus.yellowpeachxgp.com/api/v1
ADMIN_BASE_URL=https://campus.yellowpeachxgp.com/console
TZ=UTC
DEFAULT_SCHOOL_TIMEZONE=Asia/Shanghai

# XPEACH SSO (Read-only upstream; zero source code modification)
OIDC_DISCOVERY_URL=https://sso.xpeach.codes/t/acme/.well-known/openid-configuration
OIDC_CLIENT_ID=day-in-school-cloud
OIDC_CLIENT_SECRET_REF=secret://campus-cloud/prod/oidc-web-client
OIDC_REDIRECT_URI=https://campus.yellowpeachxgp.com/api/v1/auth/oidc/callback
OIDC_EXPECTED_ISSUER=https://sso.xpeach.codes/t/acme
OIDC_ALLOWED_SCOPES=openid profile email

# Database & queue
DATABASE_URL_REF=secret://campus-cloud/prod/postgres
REDIS_URL_REF=secret://campus-cloud/prod/redis
KMS_KEY_ID=cn-kms-campus-cloud-kek-v1
CLOUD_SESSION_SIGNING_KEY_REF=secret://campus-cloud/prod/session-signing

# Finance bridge: restricted to finance-bridge workload, never exposed to app/api/worker
SSO_FINANCE_BASE_URL=https://sso.xpeach.codes
SSO_INTERNAL_SERVICE_KEY_REF=secret://campus-cloud/prod/sso-finance-internal
FINANCE_BRIDGE_ALLOWED_SITE=dis
FINANCE_ENABLE_REAL_DEBITS=false

# Library provider: fail closed by default
SCHOOL_AUTOMATION_GLOBAL_ENABLED=false
SCHOOL_HAUT_AUTOMATION_ENABLED=false
SCHOOL_HAUT_AUTHORIZATION_EVIDENCE_REF=
SCHOOL_HAUT_MAX_CONCURRENT_WRITES=0
SCHOOL_HAUT_ALLOWED_OPERATIONS=READ_MY_BOOKINGS

# Logging and audit
LOG_REDACTION_STRICT=true
AUDIT_RETENTION_DAYS=180

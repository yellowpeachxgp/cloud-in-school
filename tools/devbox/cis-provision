#!/usr/bin/env bash
# Provision only the campus-owned part of the devbox.
set -Eeuo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=cis-common.sh
. "$SCRIPT_DIR/cis-common.sh"

usage() {
  cat >&2 <<'USAGE'
Usage: cis-provision <all|dirs|gradle-cache|repos|node|android> [...]

Provisions only the resolved campus root and campus bare repositories:
  dirs          create the required campus directory tree
  gradle-cache  write the campus Gradle resource properties
  repos         clone/update the two public bare repositories
  node          install a campus-local Node.js 22 toolchain (official tarball, SHA-256 checked)
  android       install Android command-line tools and API 36 SDK packages (SHA-256 checked)
  all           run all of the above

No enterprise container, runner, directory, or credential is touched.
USAGE
}

provision_dirs() {
  mkdir -p     "$CIS_CAMPUS_ROOT/repos"     "$CIS_CAMPUS_ROOT/build"     "$CIS_CAMPUS_ROOT/cache/gradle"     "$CIS_CAMPUS_ROOT/cache/npm"     "$CIS_CAMPUS_ROOT/android-sdk"     "$CIS_CAMPUS_ROOT/bin"     "$CIS_CAMPUS_ROOT/locks"     "$CIS_CAMPUS_ROOT/logs"     "$CIS_CAMPUS_ROOT/artifacts"
  printf '%s\n' 'CIS_PROVISION_DIRS=ok'
}

provision_gradle_cache() {
  mkdir -p "$CIS_CAMPUS_ROOT/cache/gradle"
  cat > "$CIS_CAMPUS_ROOT/cache/gradle/gradle.properties" <<'EOF'
org.gradle.jvmargs=-Xmx3g -XX:MaxMetaspaceSize=768m -Dfile.encoding=UTF-8
kotlin.daemon.jvmargs=-Xmx2g
org.gradle.workers.max=6
org.gradle.daemon.idletimeout=600000
org.gradle.parallel=true
org.gradle.caching=true
android.useAndroidX=true
kotlin.code.style=official
android.nonTransitiveRClass=true
android.suppressUnsupportedCompileSdk=36
EOF
  printf 'CIS_PROVISION_GRADLE_CACHE=%s\n' "$CIS_CAMPUS_ROOT/cache/gradle/gradle.properties"
}

clone_or_update_bare() {
  local repo=$1 url=$2 target="$CIS_CAMPUS_ROOT/repos/$1.git"
  if [ ! -d "$target/objects" ]; then
    git clone --bare "$url" "$target"
  else
    git --git-dir="$target" remote set-url origin "$url"
    git --git-dir="$target" fetch origin '+refs/heads/main:refs/heads/main'
  fi
  printf 'CIS_PROVISION_REPO=%s main=%s\n' "$repo" "$(git --git-dir="$target" rev-parse refs/heads/main)"
}

provision_repos() {
  provision_dirs
  clone_or_update_bare day-in-school https://github.com/yellowpeachxgp/day-in-school.git
  clone_or_update_bare cloud-in-school https://github.com/yellowpeachxgp/cloud-in-school.git
}

provision_node() {
  provision_dirs
  local version archive url shasums cache extracted selected
  version=${CIS_NODE22_VERSION:-v22.23.5}
  case "$version" in v22.*) ;; *) cis_die "CIS_NODE22_VERSION must be a v22.x version, got: $version" ;; esac

  if [ -x "$CIS_CAMPUS_ROOT/node/bin/node" ]; then
    local current_major
    current_major=$("$CIS_CAMPUS_ROOT/node/bin/node" -p 'process.versions.node.split(".")[0]' 2>/dev/null || printf '0')
    if [ "$current_major" = 22 ]; then
      printf 'CIS_PROVISION_NODE=existing %s\n' "$("$CIS_CAMPUS_ROOT/node/bin/node" --version)"
      return 0
    fi
  fi

  archive="node-$version-linux-x64.tar.xz"
  url="https://nodejs.org/dist/$version/$archive"
  shasums="https://nodejs.org/dist/$version/SHASUMS256.txt"
  cache="$CIS_CAMPUS_ROOT/cache/node"
  mkdir -p "$cache"

  curl -fL --retry 3 -o "$cache/$archive" "$url"
  curl -fL --retry 3 -o "$cache/SHASUMS256.txt" "$shasums"
  grep -E "[[:space:]]$archive$" "$cache/SHASUMS256.txt" > "$cache/selected.sha256"
  (cd "$cache" && sha256sum -c selected.sha256)

  extracted="$cache/node-$version-linux-x64"
  rm -rf -- "$extracted"
  tar -xJf "$cache/$archive" -C "$cache"
  if [ -d "$CIS_CAMPUS_ROOT/node" ]; then
    rm -rf -- "$CIS_CAMPUS_ROOT/node.previous"
    mv "$CIS_CAMPUS_ROOT/node" "$CIS_CAMPUS_ROOT/node.previous"
  fi
  mv "$extracted" "$CIS_CAMPUS_ROOT/node"
  rm -rf -- "$CIS_CAMPUS_ROOT/node.previous"
  printf 'CIS_PROVISION_NODE=%s\n' "$("$CIS_CAMPUS_ROOT/node/bin/node" --version)"
}

provision_android() {
  provision_dirs
  local sdk version sha archive url cache tmp
  sdk="$CIS_CAMPUS_ROOT/android-sdk"
  version=${CIS_ANDROID_CMDTOOLS_VERSION:-15859902}
  sha=${CIS_ANDROID_CMDTOOLS_SHA256:-4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583}
  archive="commandlinetools-linux-${version}_latest.zip"
  url="https://dl.google.com/android/repository/$archive"
  cache="$CIS_CAMPUS_ROOT/cache/android"
  tmp="$cache/extract"
  mkdir -p "$cache" "$sdk"

  if [ ! -x "$sdk/cmdline-tools/latest/bin/sdkmanager" ]; then
    curl -fL --retry 3 -o "$cache/$archive" "$url"
    printf '%s  %s\n' "$sha" "$cache/$archive" | sha256sum -c -
    rm -rf -- "$tmp"
    mkdir -p "$tmp"
    unzip -q "$cache/$archive" -d "$tmp"
    mkdir -p "$sdk/cmdline-tools"
    rm -rf -- "$sdk/cmdline-tools/latest"
    mv "$tmp/cmdline-tools" "$sdk/cmdline-tools/latest"
  fi

  export PATH="$sdk/cmdline-tools/latest/bin:$PATH"
  local sdkm=(sdkmanager --sdk_root="$sdk")

  # Accept SDK licenses in the same way hosted Android CI images do. This is an
  # INF-00 autonomous decision candidate and must be reviewed by the maintainer;
  # the marker stays on the devbox and contains no credential.
  set +o pipefail
  yes | "${sdkm[@]}" --licenses >/dev/null
  license_rc=$?
  set -o pipefail
  if [ "$license_rc" -ne 0 ]; then
    cis_die "Android SDK license acceptance failed"
  fi
  mkdir -p "$sdk/licenses"
  printf '%s\n' 'Android SDK licenses accepted for infrastructure CI parity by INF-00; maintainer review pending.' > "$sdk/licenses/INF-00-license-decision.txt"

  "${sdkm[@]}" 'platforms;android-36' 'build-tools;36.0.0' 'platform-tools'

  if id -nG 2>/dev/null | tr ' ' '\n' | grep -qx kvm; then
    "${sdkm[@]}" 'emulator' 'system-images;android-36;google_apis;x86_64'
    printf '%s\n' 'CIS_PROVISION_ANDROID_EMULATOR=installed (kvm group present)'
  else
    printf '%s\n' 'CIS_PROVISION_ANDROID_EMULATOR=skipped (kvm group absent)'
  fi

  printf 'CIS_PROVISION_ANDROID_SDK=%s\n' "$sdk"
  printf 'CIS_PROVISION_ANDROID_CMDLINE_TOOLS=%s\n' "$version"
}

run_one() {
  case "$1" in
    dirs) provision_dirs ;;
    gradle-cache) provision_gradle_cache ;;
    repos) provision_repos ;;
    node) provision_node ;;
    android) provision_android ;;
    all)
      provision_dirs
      provision_gradle_cache
      provision_repos
      provision_node
      provision_android
      ;;
    -h|--help) usage ;;
    *) cis_die "unknown provision target: $1" ;;
  esac
}

if [ "$#" -eq 0 ]; then
  usage
  exit 64
fi
for target in "$@"; do
  run_one "$target"
done

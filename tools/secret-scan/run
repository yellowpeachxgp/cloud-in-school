#!/usr/bin/env bash
# cis-gate integration wrapper. Runtime-only sensitive literals are gathered in
# the process environment or from the executing account/host; they are exported
# through CIS_SECRET_SCAN_EXTRA_LITERALS rather than exposed as command-line argv.
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)

extra_literals=$(printenv CIS_SECRET_SCAN_EXTRA_LITERALS 2>/dev/null || true)
append_extra_literal() {
  value="$1"
  value_len=$(printf '%s' "$value" | wc -c | tr -d ' ')
  [ "$value_len" -ge 4 ] || return 0
  if [ -n "$extra_literals" ]; then
    extra_literals="$extra_literals
$value"
  else
    extra_literals="$value"
  fi
}

if env | grep -q '^CIS_CAMPUS_ROOT='; then
  if command -v id >/dev/null 2>&1; then
    append_extra_literal "$(id -un 2>/dev/null || true)"
  fi
  append_extra_literal "$(hostname -f 2>/dev/null || hostname 2>/dev/null || true)"
fi

if [ -n "$extra_literals" ]; then
  export CIS_SECRET_SCAN_EXTRA_LITERALS="$extra_literals"
fi
exec node "$script_dir/scan.mjs" --root "$repo_root" "$@"

### 85. CT-06 Publish Approved Maintainer-Signed Content Pack Version (planned)
# Signature fields are shape examples only: a real maintainer must sign the exact artifact payload offline with a pinned trusted key before publishing.
# Publish is an independent operations duty; content_pack.submit/review never imply content_pack.publish, and deployment must not rely on one principal to complete submit+review+publish.
POST http://127.0.0.1:4100/api/v1/admin/content-packs
Authorization: Bearer <operations_publisher_access_token>
Content-Type: application/json
Idempotency-Key: content_pack_publish_demo_0001

{
  "submission_id": "12121212-1212-4212-8212-121212121212",
  "signature": {
    "algorithm": "Ed25519",
    "scheme": "DIS_DATAPACK_CANONICAL_JSON_SHA256_V1",
    "public_key_fingerprint": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
    "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==",
    "signed_payload_sha256": "0dfa9ac05936c4b6f51ba1dad6330fa161b54052659a6ef9e4d35b15821aa910"
  },
  "release_note": "首个公开来源办事流程数据包；仍标 UNVERIFIED"
}

